{
  "name": "takealot-selector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:inventory": "node scripts/test-inventory-actions.cjs && node scripts/test-inventory-actions-edge.cjs",
    "test:products": "node scripts/test-product-pagination.cjs",
    "test:buybox": "node scripts/test-buybox-status.cjs",
    "test:images": "node scripts/test-product-image.cjs",
    "test:price": "node scripts/test-price-parse.cjs",
    "test:bookmarklet": "node scripts/test-takealot-bookmarklet.cjs",
    "test:values": "node scripts/test-value-coercion.cjs",
    "test:audit-safety": "python scripts/test-ui-audit-safety.py && python scripts/test-longtitle-audit-safety.py && node scripts/test-longtitle-focus.cjs",
    "check:visual": "node scripts/check-visual-consistency.cjs",
    "check:types": "tsc --noEmit",
    "check": "npm run check:types && npm run check:visual && npm run test:audit-safety && npm run test:buybox && npm run test:products && npm run test:inventory && npm run test:images && npm run test:price && npm run test:bookmarklet && npm run test:values"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "26.1.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.7"
  }
}
