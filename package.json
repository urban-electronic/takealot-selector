{
  "name": "takealot-selector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:inventory": "node scripts/test-inventory-actions.cjs && node scripts/test-inventory-actions-edge.cjs",
    "test:products": "node scripts/test-product-pagination.cjs",
    "test:buybox": "node scripts/test-buybox-status.cjs && node scripts/test-buybox-copy.cjs",
    "test:images": "node scripts/test-product-image.cjs",
    "test:price": "node scripts/test-price-parse.cjs",
    "test:bookmarklet": "node scripts/test-takealot-bookmarklet.cjs",
    "test:values": "node scripts/test-value-coercion.cjs",
    "test:operations": "node scripts/test-operations.cjs",
    "test:procurement": "node scripts/test-procurement-identity.cjs",
    "test:packing": "node scripts/test-packing-display.cjs",
    "test:pricing": "node scripts/test-pricing-layout.cjs",
    "test:dashboard": "node scripts/test-dashboard-tasks.mjs",
    "test:page-import": "node scripts/test-page-import.mjs",
    "test:collector": "node scripts/test-browser-collector.mjs",
    "test:audit-safety": "python scripts/test-ui-audit-safety.py && python scripts/test-longtitle-audit-safety.py && node scripts/test-longtitle-focus.cjs",
    "check:visual": "node scripts/check-visual-consistency.cjs",
